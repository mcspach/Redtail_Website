---
import '../styles/global.scss';

import Grain from '../components/sections/Grain.astro';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import { toAbsoluteUrl, withBase } from '../utils/paths';
import {
  buildBreadcrumbList,
  buildGraph,
  buildOrganization,
  buildWebPage,
  buildWebSite,
  serializeJsonLd,
} from '../utils/schema';
import {
  SITE_DESCRIPTION,
  SITE_NAME,
  SITE_SOCIAL_IMAGE_PATH,
} from '../data/site';

const DEFAULT_TITLE = 'RedTail Web Design | Digital Solutions in Clovis CA';
const DEFAULT_DESCRIPTION = SITE_DESCRIPTION;
const DEFAULT_SOCIAL_IMAGE_PATH = SITE_SOCIAL_IMAGE_PATH;
const DEFAULT_THEME_COLOR = '#ffffff';

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  canonicalPath = '/',
  socialImagePath = DEFAULT_SOCIAL_IMAGE_PATH,
  ogType = 'website',
  noindex = false,
  pageType = 'WebPage',
  isHomePage = false,
  breadcrumbs = null,
  mainEntityId = undefined,
  schema = [],
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://www.redtailwebdesign.com');
const canonicalUrl = toAbsoluteUrl(canonicalPath, siteUrl);
const socialImageUrl = toAbsoluteUrl(socialImagePath, siteUrl);

// Every page emits one JSON-LD @graph: the shared Organization and WebSite
// nodes, this page's WebPage node, an optional BreadcrumbList, plus whatever
// page-specific nodes the caller passed in. buildGraph dedupes by @id.
const jsonLd = serializeJsonLd(
  buildGraph([
    buildOrganization(siteUrl),
    buildWebSite(siteUrl),
    buildWebPage({
      site: siteUrl,
      path: canonicalPath,
      name: title,
      description,
      imageUrl: socialImageUrl,
      type: pageType,
      isHomePage,
      hasBreadcrumb: Boolean(breadcrumbs?.length),
      mainEntityId,
    }),
    ...(breadcrumbs?.length
      ? [buildBreadcrumbList(breadcrumbs, canonicalPath, siteUrl)]
      : []),
    ...schema,
  ]),
);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={DEFAULT_THEME_COLOR} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="icon" href={withBase('/favicon-32x32.png')} type="image/png" sizes="32x32" />
    <link rel="icon" href={withBase('/favicon-16x16.png')} type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} sizes="180x180" />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <link rel="mask-icon" href={withBase('/safari-pinned-tab.svg')} color="#420000" />
    <meta name="msapplication-config" content={withBase('/browserconfig.xml')} />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <script type="application/ld+json" is:inline set:html={jsonLd} />

    <script is:inline>
      (() => {
        const introKey = 'redtail:hasSeenIntro';
        const navKey = 'redtail:navCover';
        const root = document.documentElement;

        try {
          if (window.sessionStorage.getItem(navKey) === 'true') {
            root.classList.add('rt-nav-boot');
          } else if (window.sessionStorage.getItem(introKey) !== 'true') {
            root.classList.add('rt-intro-boot');
          }
        } catch {
          root.classList.add('rt-intro-boot');
        }
      })();
    </script>

    <!-- Adobe Fonts (Cinzel and Open Sans Semicondensed) -->
    <link rel="stylesheet" href="https://use.typekit.net/waa4jxr.css">
  </head>

  <body>
    <div
      class="site-transition"
      aria-hidden="true"
      data-site-transition
    >
      <img
        src={withBase('/images/graphics/Logo_Lockup_Red.svg')}
        alt=""
        class="site-transition__logo"
        width="280"
        height="84"
        loading="eager"
        decoding="async"
      />
    </div>

    <div id="site-root">
      <Grain />
      <Header />
      <slot />
      <Footer />
    </div>

    <script>
      import '../scripts/animations.js';
      import '../scripts/animations2.js';
      import '../scripts/video-autoplay.js';
    </script>
</body>
</html>
