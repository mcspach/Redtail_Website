---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Heading from '../ui/Heading.astro';
import Button from '../ui/Button.astro';
import { offerings } from '../../data/services';

const { showHeading = true } = Astro.props;
---

<Section class="services-list" tone="light">
  <Container size="wide">
    {showHeading && <Heading>Offerings</Heading>}

    <div class="services-list__grid">
      {offerings.map((offering) => (
        <article
          class:list={[
            'services-list__card',
            offering.layout && `services-list__card--${offering.layout}`,
          ]}
        >
          <div class="services-list__card-inner">
            <h3>{offering.title}</h3>
            <p>{offering.description}</p>

            {offering.bullets && (
              <ul aria-label={`${offering.title} details`}>
                {offering.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>

    <div class="services-list__actions">
      <Button href="/contact/">Get a Quote</Button>
    </div>
  </Container>
</Section>
