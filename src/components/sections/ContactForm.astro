---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';

const formAction =
  'https://docs.google.com/forms/d/e/1FAIpQLSe_UzF6bfjEtJB8ST2pDyePFs3ZxsG89tUzPK5KXbsEtJwLtg/formResponse';

const fields = {
  name: 'entry.2005620554',
  business: 'entry.881075160',
  email: 'entry.1045781291',
  phone: 'entry.1166974658',
  message: 'entry.839337160',
  budget: 'entry.1933105247',
};
---

<Section class="contact-form-section" tone="light">
  <Container size="wide">
    <div class="contact-form-section__layout">
      <div class="contact-form-section__intro">
        <p class="contact-form-section__eyebrow">Start A Project</p>
        <h3>Tell us what you&apos;re building and we&apos;ll follow up with next steps.</h3>
        <p>
          Share a few details about your business, goals, and timeline. We&apos;ll
          use this to prepare for the conversation and point you toward the best
          starting place.
        </p>

        <div class="contact-form-section__details">
          <div>
            <span class="contact-form-section__detail-label">Email</span>
            <a href="mailto:matthew@redtailwebdesign.com">
              matthew@redtailwebdesign.com
            </a>
          </div>

          <div>
            <span class="contact-form-section__detail-label">Based In</span>
            <p>Clovis, California</p>
          </div>

          <div>
            <span class="contact-form-section__detail-label">Best For</span>
            <p>Brand-led websites, redesigns, and strategic direction.</p>
          </div>
        </div>
      </div>

      <div class="contact-form-section__form form-shell">
        <form
          class="contact-form"
          action={formAction}
          method="POST"
          target="_blank"
          data-contact-form
        >
          <div class="contact-form__grid">
            <div class="field-group">
              <label class="field-label" for="contact-name">Name</label>
              <input
                id="contact-name"
                name={fields.name}
                type="text"
                autocomplete="name"
                placeholder="Jane Doe"
                required
              />
            </div>

            <div class="field-group">
              <label class="field-label" for="contact-business">
                Business Name
              </label>
              <input
                id="contact-business"
                name={fields.business}
                type="text"
                autocomplete="organization"
                placeholder="Acme Co."
              />
            </div>

            <div class="field-group">
              <label class="field-label" for="contact-email">Email</label>
              <input
                id="contact-email"
                name={fields.email}
                type="email"
                autocomplete="email"
                placeholder="jane@acme.com"
                required
              />
            </div>

            <div class="field-group">
              <label class="field-label" for="contact-phone">
                Phone <span class="field-label__hint">Optional</span>
              </label>
              <input
                id="contact-phone"
                name={fields.phone}
                type="tel"
                autocomplete="tel"
                placeholder="(555) 555-5555"
              />
            </div>

            <div class="field-group contact-form__field--full">
              <label class="field-label" for="contact-message">
                How can we help you?
              </label>
              <textarea
                id="contact-message"
                name={fields.message}
                rows="5"
                placeholder="Tell us about your business, goals, and timeline."
                required></textarea>
            </div>

            <div class="field-group contact-form__field--full">
              <label class="field-label" for="contact-budget">
                Budget <span class="field-label__hint">Optional</span>
              </label>
              <input
                id="contact-budget"
                name={fields.budget}
                type="text"
                inputmode="numeric"
                placeholder="$7,000"
              />
            </div>
          </div>

          <div class="contact-form__consent">
            <input
              id="contact-human"
              name="humanCheck"
              type="checkbox"
              value="yes"
              required
              data-contact-human
            />
            <label for="contact-human">I&apos;m not a robot</label>
          </div>

          <div class="contact-form__honeypot" aria-hidden="true">
            <label for="contact-company-url">Leave this field empty</label>
            <input
              id="contact-company-url"
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div class="contact-form__actions">
            <button class="button button--primary" type="submit" data-contact-submit>
              Send Inquiry
            </button>
            <p class="contact-form__note">
              We usually reply within one business day.
            </p>
          </div>

          <p class="contact-form__status" role="status" aria-live="polite" data-contact-status></p>
        </form>

        <iframe
          class="contact-form__sink"
          name="contact-form-sink"
          title="Form submission target"
          aria-hidden="true"
          tabindex="-1"></iframe>
      </div>
    </div>
  </Container>
</Section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const sink = document.querySelector<HTMLIFrameElement>('.contact-form__sink');

  if (form && sink) {
    const submitButton = form.querySelector<HTMLButtonElement>('[data-contact-submit]');
    const status = form.querySelector<HTMLElement>('[data-contact-status]');
    const honeypot = form.querySelector<HTMLInputElement>('[name="website"]');
    const humanCheck = form.querySelector<HTMLInputElement>('[data-contact-human]');
    const defaultLabel = submitButton?.textContent?.trim() ?? 'Send Inquiry';

    // Bot heuristics. None of these are real security — the Google Forms
    // endpoint is public, so a targeted bot can POST straight past all of it.
    // They only filter crawlers that scrape and submit the rendered form.
    const loadedAt = Date.now();
    const MIN_FILL_MS = 3000;
    let checkedByHuman = false;

    // A scripted `checkbox.checked = true` produces no event, and a synthetic
    // click reports isTrusted === false. Only a real pointer/keyboard flips this.
    humanCheck?.addEventListener('change', (event) => {
      if (event.isTrusted && humanCheck.checked) checkedByHuman = true;
      if (!humanCheck.checked) checkedByHuman = false;
    });

    // Progressive enhancement: without JS the form posts to a new tab and
    // Google shows its own confirmation. With JS we post to the hidden frame
    // and report the result inline instead.
    form.target = 'contact-form-sink';

    let pending = false;
    let failsafe = 0;

    const setStatus = (message: string, state: 'success' | 'error' | '') => {
      if (!status) return;
      status.textContent = message;
      status.dataset.state = state;
    };

    const finish = (message: string, state: 'success' | 'error') => {
      if (!pending) return;
      pending = false;
      window.clearTimeout(failsafe);
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = defaultLabel;
      }
      setStatus(message, state);
    };

    form.addEventListener('submit', (event) => {
      if (honeypot?.value) {
        event.preventDefault();
        return;
      }

      if (pending) {
        event.preventDefault();
        return;
      }

      if (humanCheck && !checkedByHuman) {
        event.preventDefault();
        setStatus(
          'Please confirm the “I’m not a robot” checkbox before sending.',
          'error',
        );
        humanCheck.focus();
        return;
      }

      if (Date.now() - loadedAt < MIN_FILL_MS) {
        event.preventDefault();
        setStatus('Please take a moment to review your details, then send again.', 'error');
        return;
      }

      pending = true;
      setStatus('', '');

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = 'Sending…';
      }

      failsafe = window.setTimeout(() => {
        finish(
          'That took longer than expected. Email matthew@redtailwebdesign.com and we’ll pick it up from there.',
          'error',
        );
      }, 12000);
    });

    sink.addEventListener('load', () => {
      if (!pending) return; // ignore the initial about:blank load
      form.reset();
      finish('Thanks. Your inquiry is in. We’ll follow up shortly.', 'success');
    });
  }
</script>
